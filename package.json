{
  "name": "bdavanzada-videojuego",
  "author": "Adrian Thompson, Ernesto Juarez and Marian Zamorano",
  "license": "MIT",
  "version": "1.0.0",
  "scripts": {
    "dev": "docker-compose -f docker-compose.yml --env-file .env up -d",
    "stop": "docker-compose -f docker-compose.yml --env-file .env down",
    "stop2": "docker-compose down",
    "backup": "node backupDeadIsland2/scripts/backup.js",
    "restore": "node backupDeadIsland2/scripts/restore.js",
    "rmvolumen": "docker volume rm proyectobasededatosavanzada_pgdata proyectobasededatosavanzada_mariadbdata proyectobasededatosavanzada_mongodata proyectobasededatosavanzada_redisdata",
    "rmvolumen-mariadb": "docker volume rm proyectobasededatosavanzada_mariadbmasterdata proyectobasededatosavanzada_mariadbslave1data proyectobasededatosavanzada_mariadbslave2data",
    "sharding": "node shardingDeadIsland2/scripts/sharding.js",
    "cache": "node init/redis/index.js",
    "mysql:master": "docker exec -it mariadb-master mysql -uroot -p",
    "mysql:slave1": "docker exec -it mariadb-slave1 mysql -uroot -p",
    "mysql:slave2": "docker exec -it mariadb-slave2 mysql -uroot -p"
  },
  "dependencies": {
    "cron": "^4.3.1",
    "dotenv": "^16.5.0",
    "mongodb": "^6.17.0",
    "postgres": "^3.4.7",
    "redis": "^5.5.6"
  }
}
